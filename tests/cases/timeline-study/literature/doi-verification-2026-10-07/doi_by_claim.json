  "groups": [
    {
      "id": "history",
      "label": "场地分析、区域调查与叠图前史",
      "claims": [
        {
          "id": "DS001",
          "statement": "城市设计中利用自然以服务健康、安全与公共福祉的传统早于现代生态规划。",
          "dois": [
            "10.1177/0739456x8500500106"
          ]
        },
        {
          "id": "DS002",
          "statement": "美国土地适宜性分析在20世纪初已有文献记录的应用；2001综述已讨论神经计算和演化程序等技术。",
          "dois": [
            "10.1007/s002670010247"
          ]
        },
        {
          "id": "DS003",
          "statement": "Hein与van Mil的研究将Geddes、Tyrwhitt的先调查后规划与叠合地图观察空间模式联系起来，并明确讨论Tyrwhitt1950文本。",
          "dois": [
            "10.17645/up.v5i2.2803"
          ]
        },
        {
          "id": "DS004",
          "statement": "Tyrwhitt在1941—1951年参与跨国规划话语，并将Geddes的生物区域思想与欧洲现代主义相结合。",
          "dois": [
            "10.1017/s0963926809006282"
          ]
        },
        {
          "id": "DS005",
          "statement": "Steinitz以参与者身份回顾1963—1970年Harvard计算制图实验室的早期GIS开发与应用实验。",
          "dois": [
            "10.1080/02665433.2013.860762"
          ]
        },
        {
          "id": "DS006",
          "statement": "Kiefer1965年论文提出为都市边缘地区土地利用总体规划分析土地物理特征的方法与建议。",
          "dois": [
            "10.1016/0007-3628(65)90013-7"
          ]
        }
      ]
    },
    {
      "id": "taxonomy",
      "label": "已有分类与跨方法比较",
      "claims": [
        {
          "id": "DS007",
          "statement": "Hopkins1977年已经提出土地适宜性方法分类，并比较同质区域识别及用途适宜性评级方法。",
          "dois": [
            "10.1080/01944367708977903"
          ]
        },
        {
          "id": "DS008",
          "statement": "Zube等1982年从1965—1980年160余篇研究中区分专家、心理物理、认知与体验四种景观感知范式。",
          "dois": [
            "10.1016/0304-3924(82)90009-0"
          ]
        },
        {
          "id": "DS009",
          "statement": "Malczewski2006年综述对1990—2004年的300余篇GIS-MCDA期刊论文进行分类并辨识发展趋势。",
          "dois": [
            "10.1080/13658810600661508"
          ]
        },
        {
          "id": "DS010",
          "statement": "Cinelli等2020年把MCDA过程的特征组织为问题表述、决策建议构建及定性特征与技术支持三个部分。",
          "dois": [
            "10.1016/j.omega.2020.102261"
          ]
        },
        {
          "id": "DS011",
          "statement": "Jankowski1995年给出GIS与MCDM整合框架，对MCDM方法分类并匹配决策者的选择方式。",
          "dois": [
            "10.1080/02693799508902036"
          ]
        }
      ]
    },
    {
      "id": "structure",
      "label": "模型结构、价值尺度与科学化边界",
      "claims": [
        {
          "id": "DS012",
          "statement": "Steinitz1990年提出组织景观设计问题的六层框架，每层对应一种建模类型。",
          "dois": [
            "10.3368/lj.9.2.136"
          ]
        },
        {
          "id": "DS013",
          "statement": "Rittel与Webber指出，社会政策规划中的问题界定、公共利益和最优解都受到价值分歧与条件限制。",
          "dois": [
            "10.1007/bf01405730"
          ]
        },
        {
          "id": "DS014",
          "statement": "WLC是GIS复合地图的一种决策规则；忽视其适用假设可能导致不当应用和可疑结果。",
          "dois": [
            "10.1111/1467-9671.00035"
          ]
        },
        {
          "id": "DS015",
          "statement": "准则权重在不同聚合规则下具有不同解释，必须结合测量尺度、可通约性及所采用的模型理解。",
          "dois": [
            "10.1016/s0360-8352(00)00019-x"
          ]
        },
        {
          "id": "DS016",
          "statement": "Dyer与Sarin1979年讨论可测多属性价值函数，并给出加法、乘法及更复杂形式成立的条件。",
          "dois": [
            "10.1287/opre.27.4.810"
          ]
        },
        {
          "id": "DS017",
          "statement": "Greco等2008年利用与偏好信息兼容的一组加法价值函数，分别定义对全部函数成立的必要偏好和至少一个函数成立的可能偏好。",
          "dois": [
            "10.1016/j.ejor.2007.08.013"
          ]
        }
      ]
    },
    {
      "id": "methods",
      "label": "偏好获取及不同聚合／比较方法",
      "claims": [
        {
          "id": "DS018",
          "statement": "Saaty1977年研究成对比较矩阵主特征向量标度、一致性及层级结构中的综合优先度。",
          "dois": [
            "10.1016/0022-2496(77)90033-5"
          ]
        },
        {
          "id": "DS019",
          "statement": "AHP不仅从专家成对比较得到优先尺度，还通过父节点优先度进行层级综合。",
          "dois": [
            "10.1504/ijssci.2008.017590"
          ]
        },
        {
          "id": "DS020",
          "statement": "Yager1988年提出OWA聚合算子，并研究其介于AND与OR型聚合之间的性质。",
          "dois": [
            "10.1109/21.87068"
          ]
        },
        {
          "id": "DS021",
          "statement": "Jiang与Eastman2000年讨论GIS中的Boolean与WLC，并以模糊测度及OWA连接因子标准化和聚合问题。",
          "dois": [
            "10.1080/136588100240903"
          ]
        },
        {
          "id": "DS022",
          "statement": "Malczewski2006年把模糊语言量词引入GIS土地适宜性的OWA程序，通过参数变化表达不同决策策略。",
          "dois": [
            "10.1016/j.jag.2006.01.003"
          ]
        },
        {
          "id": "DS023",
          "statement": "UTA用方案的多准则评价和主观弱序，通过序数回归与线性规划估计加法效用函数，并进行稳定性分析。",
          "dois": [
            "10.1016/0377-2217(82)90155-2"
          ]
        },
        {
          "id": "DS024",
          "statement": "Roy1968年发表多观点排序与选择论文；原文参考文献列有1966年ELECTRE技术报告。",
          "dois": [
            "10.1051/ro/196802v100571"
          ]
        },
        {
          "id": "DS025",
          "statement": "Joerin等将GIS与ELECTRE-TRI结合，用于瑞士地区住房土地适宜性分类。",
          "dois": [
            "10.1080/13658810051030487"
          ]
        },
        {
          "id": "DS026",
          "statement": "PROMETHEE I给出部分预序，PROMETHEE II给出全预序，体现不同方法的输出结构差异。",
          "dois": [
            "10.1287/mnsc.31.6.647"
          ]
        }
      ]
    },
    {
      "id": "uncertainty",
      "label": "权重空间、不确定性与敏感性",
      "claims": [
        {
          "id": "DS027",
          "statement": "SMAA1998通过探索权重空间描述哪些评价支持某个方案成为首选，并允许以概率分布表达不确定输入。",
          "dois": [
            "10.1016/s0377-2217(97)00163-x"
          ]
        },
        {
          "id": "DS028",
          "statement": "SMAA-2在2001年将原SMAA扩展到所有名次，并考虑部分偏好信息。",
          "dois": [
            "10.1287/opre.49.3.444.11220"
          ]
        },
        {
          "id": "DS029",
          "statement": "2004年的空间多准则敏感性综述考察28项研究，指出当时敏感性分析不普遍，常见做法是改变因素权重。",
          "dois": [
            "10.1080/10807030490887221"
          ]
        },
        {
          "id": "DS030",
          "statement": "Feick与Hall2004年提出研究多准则权重敏感性的空间维度，结合不同参与者的评价和地图表达。",
          "dois": [
            "10.1080/13658810412331280185"
          ]
        },
        {
          "id": "DS031",
          "statement": "Chen、Yu与Khan2010年把逐一改变权重的OAT敏感性分析与AHP、ArcGIS结合，显示土地适宜性结果的空间变化。",
          "dois": [
            "10.1016/j.envsoft.2010.06.001"
          ]
        },
        {
          "id": "DS032",
          "statement": "Ligmann-Zielinska与Jankowski2014年通过Monte Carlo探索准则权重空间，并为每个空间单元生成适宜性、不确定性及敏感性图。",
          "dois": [
            "10.1016/j.envsoft.2014.03.007"
          ]
        },
        {
          "id": "DS033",
          "statement": "GIS模型中的不确定性分析研究输入与参数不确定性向输出的传播，敏感性分析研究不同来源对输出不确定性的重要性。",
          "dois": [
            "10.1080/13658810110053125"
          ]
        },
        {
          "id": "DS034",
          "statement": "Dias与Vetschera2019年指出直接随机生成效用值可能使效用函数形状产生抽样偏差，并提出减轻偏差的方法。",
          "dois": [
            "10.1016/j.ejor.2019.04.031"
          ]
        }
      ]
    },
    {
      "id": "participation",
      "label": "群体偏好、参与及审议",
      "claims": [
        {
          "id": "DS035",
          "statement": "Malczewski1996年在栅格GIS中用TOPSIS生成个人排序，再用Borda规则组合群体偏好。",
          "dois": [
            "10.1080/02693799608902119"
          ]
        },
        {
          "id": "DS036",
          "statement": "协作式空间多准则评价已有专门综述，讨论参与过程中的任务、工具和可用性评价。",
          "dois": [
            "10.1080/13658816.2020.1776870"
          ]
        },
        {
          "id": "DS037",
          "statement": "te Boveldt等2021年比较多准则方法的数学结构及参与框架，认为政治敏感的参与阶段需要重视透明性和易用性。",
          "dois": [
            "10.1177/13563890211020334"
          ]
        }
      ]
    },
    {
      "id": "learning",
      "label": "视觉景观与学习型评价",
      "claims": [
        {
          "id": "DS038",
          "statement": "2017年已有利用Scenic-Or-Not图像评分和卷积神经网络研究、预测户外景观美感的工作。",
          "dois": [
            "10.1098/rsos.170170"
          ]
        },
        {
          "id": "DS039",
          "statement": "ScenicNet2021年将土地覆盖预测作为美感回归的可解释中间任务，连接遥感表示与众包景观评分。",
          "dois": [
            "10.1016/j.isprsjprs.2021.04.020"
          ]
        },
        {
          "id": "DS040",
          "statement": "Havinga等2021年用英国众包调查检验Flickr与深度学习的景观美感模型，并与环境指标模型比较。",
          "dois": [
            "10.1038/s41598-021-99282-0"
          ]
        },
        {
          "id": "DS041",
          "statement": "2023年视觉景观综述区分感知与评价，以及人眼视角与鸟瞰视角，并梳理相应的技术与度量。",
          "dois": [
            "10.3390/s23198135"
          ]
        }
      ]
    }
  ]
