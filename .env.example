# DeepSeek (OpenAI-compatible API)
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Web of Science Starter API (https://developer.clarivate.com/apis/wos-starter)
WOS_API_KEY=
# Max WoS requests per run (cache hits do not count; check your plan's daily quota)
WOS_MAX_REQUESTS=60
# Min interval between WoS requests (seconds)
WOS_MIN_INTERVAL=1.1

# OpenAlex (email joins the polite pool; api_key is optional)
OPENALEX_EMAIL=you@example.com
OPENALEX_API_KEY=

# Local runtime data (separate from source code and test cases)
SCIB_CACHE_DIR=artifacts/cache
SCIB_CORPORA_DIR=artifacts/runs
# Successful retrieval keeps only the latest complete result and clears cached responses.
# Set either to true for repeat experiments, or use --keep-history / --keep-cache.
SCIB_KEEP_HISTORY=false
SCIB_KEEP_CACHE=false

# Obsidian output: an existing vault to write each run into (as <vault>/SCIBooster/<run>/).
# Leave empty to write <run>/obsidian/, which can be opened as a vault on its own.
SCIB_OBSIDIAN_VAULT=
